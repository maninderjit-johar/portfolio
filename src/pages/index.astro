---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="portfolio">
    <div class="scroll-progress" aria-hidden="true"></div>
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="#home">Maninderjit Johar</a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#systems">Systems</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
      <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="primary-menu">
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
      <button class="theme-toggle" type="button" aria-label="Switch between day and night theme" aria-pressed="false">
        <span class="theme-icon sun" aria-hidden="true">☀</span>
        <span class="theme-icon moon" aria-hidden="true">☾</span>
        <span class="theme-thumb" aria-hidden="true"></span>
      </button>
      <div class="mobile-menu" id="primary-menu">
        <a href="#work">Work</a>
        <a href="#systems">Systems</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <section class="hero" id="home">
      <div class="hero-copy">
        <p class="eyebrow">Full-stack Software Developer</p>
        <h1>Full-stack product engineering, from UI to production.</h1>
        <p class="hero-text">
          7+ years building React and Next.js interfaces, backend APIs, database-backed workflows, test coverage, and Docker/Kubernetes deployments for real SaaS products.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#work">View experience</a>
          <a class="button ghost" href="mailto:maninderjit.johar@outlook.com">Email me</a>
        </div>
      </div>

      <aside class="hero-system" aria-label="Animated full-stack development diagram">
        <div class="system-screen">
          <div class="screen-bar">
            <span></span><span></span><span></span>
            <strong>full-stack-delivery</strong>
          </div>
          <div class="pipeline-map">
            <div class="pipeline-track" aria-hidden="true">
              <span class="track-line"></span>
              <span class="glow-package">
                <i></i>
              </span>
            </div>

            <div class="pipeline-stage stage-frontend">
              <span class="stage-icon"><i class="devicon-react-original"></i></span>
              <small>01 · Frontend</small>
              <strong>Build product UI</strong>
              <em>React · Next.js · TypeScript</em>
              <div class="stage-preview ui-preview" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
            </div>

            <div class="pipeline-stage stage-api">
              <span class="stage-icon"><i class="devicon-graphql-plain"></i></span>
              <small>02 · Backend API</small>
              <strong>Shape contracts</strong>
              <em>REST · GraphQL · Auth</em>
              <div class="stage-preview api-preview" aria-hidden="true">
                <span>GET</span><span>POST</span><span>200</span>
              </div>
            </div>

            <div class="pipeline-stage stage-data">
              <span class="stage-icon"><i class="devicon-postgresql-plain"></i></span>
              <small>03 · Database</small>
              <strong>Model data</strong>
              <em>PostgreSQL · Prisma · MongoDB</em>
              <div class="stage-preview data-preview" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
            </div>

            <div class="pipeline-stage stage-test">
              <span class="stage-icon"><i class="devicon-playwright-plain"></i></span>
              <small>04 · Testing</small>
              <strong>Verify behavior</strong>
              <em>Unit · Integration · Playwright</em>
              <div class="stage-preview test-preview" aria-hidden="true">
                <span>✓ API</span><span>✓ UI</span><span>✓ Flow</span>
              </div>
            </div>

            <div class="pipeline-stage stage-deploy">
              <span class="stage-icon"><i class="devicon-kubernetes-plain"></i></span>
              <small>05 · Deployment</small>
              <strong>Ship reliably</strong>
              <em>Docker · Kubernetes · CI/CD</em>
              <div class="stage-preview deploy-preview" aria-hidden="true">
                <span></span><span></span><span></span>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <div class="stack-marquee" aria-label="Core technologies">
      <div>
        <span>React</span>
        <span>Next.js</span>
        <span>TypeScript</span>
        <span>GraphQL</span>
        <span>Python</span>
        <span>Django</span>
        <span>FastAPI</span>
        <span>Docker</span>
        <span>Kubernetes</span>
        <span>GitHub Actions</span>
        <span>Grafana</span>
        <span>Google Cloud Logs</span>
      </div>
      <div aria-hidden="true">
        <span>React</span>
        <span>Next.js</span>
        <span>TypeScript</span>
        <span>GraphQL</span>
        <span>Python</span>
        <span>Django</span>
        <span>FastAPI</span>
        <span>Docker</span>
        <span>Kubernetes</span>
        <span>GitHub Actions</span>
        <span>Grafana</span>
        <span>Google Cloud Logs</span>
      </div>
    </div>

    <section class="impact-band" aria-label="Impact metrics">
      <article>
        <strong data-count="100" data-suffix="+">0</strong>
        <span>project SaaS ecosystem</span>
      </article>
      <article>
        <strong data-count="10" data-suffix="+">0</strong>
        <span>Next.js and React apps</span>
      </article>
      <article>
        <strong data-count="15" data-suffix="+">0</strong>
        <span>backend service workflows</span>
      </article>
      <article>
        <strong data-count="100" data-suffix="+">0</strong>
        <span>unit, integration, and browser tests</span>
      </article>
    </section>

    <section class="section" id="work">
      <div class="section-heading">
        <p class="eyebrow">Selected experience</p>
        <h2>Recent work across product features, APIs, testing, and releases.</h2>
      </div>

      <div class="case-grid timeline-grid">
        <article class="case-card featured">
          <div class="case-meta">
            <span>June 2024 - Present</span>
            <span>Aerialytic</span>
          </div>
          <h3>Full-stack engineering across Aerialytic’s solar software platform.</h3>
          <p>
            Rejoined Aerialytic after an earlier frontend role and moved deeper into full-stack product work across lead capture, customer workflows, proposals, admin tools, and partner-facing experiences.
          </p>
          <div class="case-stats">
            <span><strong>100+</strong> project ecosystem</span>
            <span><strong>10+</strong> Next.js/React apps</span>
            <span><strong>15+</strong> backend services</span>
            <span><strong>100+</strong> Python/API tests</span>
          </div>
          <ul>
            <li>Built reusable CRM flows that partners could embed without a separate one-off implementation each time.</li>
            <li>Implemented REST and GraphQL paths for solar design, production modeling, savings calculations, lead management, and proposal generation.</li>
            <li>Added Python unit/integration tests, golden-test scenarios, Jest checks, and Playwright coverage around calculation-heavy and user-facing flows.</li>
            <li>Containerized and released services through Docker, Kubernetes, GitHub Actions, GitOps workflows, and multi-environment deployment practices.</li>
            <li>Leveraged Grafana dashboards and Google Cloud Logs to investigate production issues, trace API behavior, and validate fixes across Docker/Kubernetes-based SaaS services.</li>
          </ul>
        </article>

        <article class="case-card">
          <div class="case-meta">
            <span>Nov 2021 - Jan 2024</span>
            <span>MarketBox</span>
          </div>
          <h3>Booking and scheduling product improvements.</h3>
          <p>
            Redesigned booking, console, and onboarding workflows for a fast-moving SaaS product.
          </p>
          <div class="case-stats compact">
            <span><strong>30%</strong> satisfaction lift</span>
            <span><strong>25%</strong> fewer scheduling errors</span>
            <span><strong>23%</strong> sales increase</span>
            <span><strong>6s -> 3.5s</strong> load-time improvement</span>
          </div>
        </article>

        <article class="case-card">
          <div class="case-meta">
            <span>Dec 2018 - Nov 2021</span>
            <span>Aerialytic</span>
          </div>
          <h3>Frontend foundations in solar data visualization.</h3>
          <p>
            Built scalable React experiences for solar-energy applications while collaborating with AI, GIS, and backend teams.
          </p>
          <div class="case-stats compact">
            <span><strong>20%</strong> faster rollout</span>
            <span><strong>97%</strong> accuracy supported</span>
          </div>
        </article>
      </div>
    </section>

    <section class="section systems" id="systems">
      <div class="section-heading">
        <p class="eyebrow">Full-stack toolkit</p>
        <h2>Tools I use across the product delivery stack.</h2>
        <p>
          The tools I reach for when a feature needs to move from a screen, through the backend, into a tested and observable release.
        </p>
      </div>

      <div class="stack-groups" aria-label="Technology stack grouped by engineering area">
        <article class="stack-group">
          <p>Frontend</p>
          <div class="tech-cloud">
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/react/react-original.svg" alt="" loading="lazy" />React</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/nextjs/nextjs-original.svg" alt="" loading="lazy" />Next.js</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/typescript/typescript-original.svg" alt="" loading="lazy" />TypeScript</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/javascript/javascript-original.svg" alt="" loading="lazy" />JavaScript</span>
          </div>
        </article>

        <article class="stack-group">
          <p>Backend + APIs</p>
          <div class="tech-cloud">
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/python/python-original.svg" alt="" loading="lazy" />Python</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/django/django-plain.svg" alt="" loading="lazy" />Django</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/fastapi/fastapi-original.svg" alt="" loading="lazy" />FastAPI</span>
            <span><i class="devicon-graphql-plain" aria-hidden="true"></i>GraphQL</span>
            <span><i class="devicon-djangorest-plain" aria-hidden="true"></i>REST</span>
          </div>
        </article>

        <article class="stack-group">
          <p>Data</p>
          <div class="tech-cloud">
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/postgresql/postgresql-original.svg" alt="" loading="lazy" />PostgreSQL</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/mongodb/mongodb-original.svg" alt="" loading="lazy" />MongoDB</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/prisma/prisma-original.svg" alt="" loading="lazy" />Prisma</span>
          </div>
        </article>

        <article class="stack-group">
          <p>Testing + Quality</p>
          <div class="tech-cloud">
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/jest/jest-plain.svg" alt="" loading="lazy" />Jest</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/playwright/playwright-original.svg" alt="" loading="lazy" />Playwright</span>
            <span><i class="devicon-pytest-plain" aria-hidden="true"></i>Pytest</span>
            <span><b>IT</b>Integration Tests</span>
            <span><b>GT</b>Golden Tests</span>
          </div>
        </article>

        <article class="stack-group">
          <p>Deployment + Observability</p>
          <div class="tech-cloud">
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/docker/docker-original.svg" alt="" loading="lazy" />Docker</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/kubernetes/kubernetes-original.svg" alt="" loading="lazy" />Kubernetes</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/githubactions/githubactions-original.svg" alt="" loading="lazy" />GitHub Actions</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/git/git-original.svg" alt="" loading="lazy" />Git</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/amazonwebservices/amazonwebservices-original-wordmark.svg" alt="" loading="lazy" />AWS</span>
            <span><img src="https://cdn.jsdelivr.net/gh/devicons/devicon/icons/grafana/grafana-original.svg" alt="" loading="lazy" />Grafana</span>
            <span><b>GCL</b>Google Cloud Logs</span>
            <span><b>CD</b>CI/CD</span>
          </div>
        </article>
      </div>

      <div class="capability-heading">
        <p class="eyebrow">Delivery ownership</p>
        <h3>From product requirements to reliable releases.</h3>
        <p>
          I like owning the messy middle of product work: clarifying the feature, building the UI, wiring the API, testing the edge cases, shipping it, and checking what happens after release.
        </p>
      </div>

      <div class="systems-grid">
        <article>
          <span>01</span>
          <h3>Interfaces that ship</h3>
          <p>React, Next.js, TypeScript, Apollo Client, responsive UI, state flows, and reusable component systems.</p>
        </article>
        <article>
          <span>02</span>
          <h3>APIs that scale</h3>
          <p>REST, GraphQL, Django, FastAPI, Python services, data modeling, and calculation-heavy product workflows.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Data that supports products</h3>
          <p>PostgreSQL, MongoDB, Prisma, relational modeling, persistence workflows, and calculation-heavy product data.</p>
        </article>
        <article>
          <span>04</span>
          <h3>Quality before release</h3>
          <p>Unit tests, integration tests, golden scenarios, Jest, Playwright, regression checks, and confidence around core workflows.</p>
        </article>
        <article>
          <span>05</span>
          <h3>Releases I can trace</h3>
          <p>Docker, Kubernetes, GitHub Actions, GitOps, CI/CD, environment configuration, Grafana dashboards, and Google Cloud Logs.</p>
        </article>
        <article>
          <span>06</span>
          <h3>Ownership after launch</h3>
          <p>Requirements, implementation, API contracts, database changes, testing, deployment, debugging, and practical iteration once real users touch the feature.</p>
        </article>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="section-heading project-heading">
        <p class="eyebrow">Public projects</p>
        <h2>Practical builds that show product and engineering depth.</h2>
      </div>

      <div class="project-grid">
        <article class="project-card">
          <div class="project-preview screenshot-preview">
            <img src="/projects/cinequiz.png" alt="CineQuiz game interface screenshot" loading="lazy" />
          </div>
          <span>React · TypeScript · Redux Toolkit</span>
          <h3>CineQuiz</h3>
          <p>Cinematic movie-guessing game with async title loading, Redux state, keyboard shortcuts, reveal flow, and success/failure animations.</p>
          <div class="project-actions">
            <a href="https://maninderjit-johar.github.io/cinequiz/" target="_blank" rel="noreferrer">Live demo</a>
            <a href="https://github.com/maninderjit-johar/cinequiz" target="_blank" rel="noreferrer">Source</a>
          </div>
        </article>
        <article class="project-card">
          <div class="project-preview screenshot-preview">
            <img src="/projects/essentialui.png" alt="EssentialUI component documentation screenshot" loading="lazy" />
          </div>
          <span>React library · Component docs · Vite</span>
          <h3>EssentialUI</h3>
          <p>Package-ready dashboard component kit with Sidebar, MetricCard, StatusBadge, EmptyState, UserCard, ProgressSteps, and ActionPanel demos.</p>
          <div class="project-actions">
            <a href="https://maninderjit-johar.github.io/essentialui/" target="_blank" rel="noreferrer">Live demo</a>
            <a href="https://github.com/maninderjit-johar/essentialui" target="_blank" rel="noreferrer">Source</a>
          </div>
        </article>
      </div>
    </section>

    <section class="contact" id="contact">
      <p class="eyebrow">Let’s talk</p>
      <h2>Need a full-stack engineer who can take features past the finish line?</h2>
      <p>
        I’m open to full-stack and frontend-heavy roles where product thinking, backend follow-through, testing, and reliable releases all matter.
      </p>
      <div class="hero-actions center">
        <a class="button primary" href="mailto:maninderjit.johar@outlook.com">Email me</a>
        <a class="button ghost" href="https://www.linkedin.com/in/manijohar/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="button ghost" href="https://github.com/maninderjit-johar" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>
  </main>
</Layout>

<script>
  const progress = document.querySelector(".scroll-progress");
  const revealTargets = document.querySelectorAll(
    ".hero-copy, .hero-system, .impact-band article, .section-heading, .case-card, .stack-group, .tech-cloud span, .systems-grid article, .project-card, .contact"
  );
  const interactiveCards = document.querySelectorAll(
    ".hero-system, .case-card, .stack-group, .tech-cloud span, .systems-grid article, .project-card, .impact-band article"
  );
  const countTargets = document.querySelectorAll("[data-count]");
  const navLinks = document.querySelectorAll(".nav-links a");
  const mobileNavLinks = document.querySelectorAll(".mobile-menu a");
  const sections = [...document.querySelectorAll("section[id]")];
  const themeToggle = document.querySelector(".theme-toggle");
  const menuToggle = document.querySelector(".menu-toggle");
  const mobileMenu = document.querySelector(".mobile-menu");

  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const storedTheme = localStorage.getItem("portfolio-theme");
  const systemTheme = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
  const initialTheme = storedTheme || systemTheme;

  document.documentElement.dataset.theme = initialTheme;

  const syncThemeToggle = () => {
    const isLight = document.documentElement.dataset.theme === "light";
    themeToggle?.setAttribute("aria-pressed", String(isLight));
  };

  syncThemeToggle();

  themeToggle?.addEventListener("click", () => {
    const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = nextTheme;
    localStorage.setItem("portfolio-theme", nextTheme);
    syncThemeToggle();
  });

  const updateProgress = () => {
    if (!progress) return;
    const scrollable = document.documentElement.scrollHeight - window.innerHeight;
    const value = scrollable > 0 ? window.scrollY / scrollable : 0;
    progress.style.setProperty("--progress", `${Math.min(value, 1) * 100}%`);
  };

  const setActiveNav = () => {
    const active = sections
      .map((section) => ({
        id: section.id,
        top: Math.abs(section.getBoundingClientRect().top - 120),
      }))
      .sort((a, b) => a.top - b.top)[0];

    [...navLinks, ...mobileNavLinks].forEach((link) => {
      link.toggleAttribute("aria-current", link.getAttribute("href") === `#${active?.id}`);
    });
  };

  const closeMobileMenu = () => {
    menuToggle?.setAttribute("aria-expanded", "false");
    mobileMenu?.classList.remove("is-open");
  };

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    mobileMenu?.classList.toggle("is-open", !isOpen);
  });

  mobileNavLinks.forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMobileMenu();
  });

  window.addEventListener("resize", () => {
    if (window.innerWidth > 920) closeMobileMenu();
  });

  const animateCount = (element) => {
    if (element.dataset.done === "true") return;
    element.dataset.done = "true";

    const end = Number(element.getAttribute("data-count") || 0);
    const suffix = element.getAttribute("data-suffix") || "";
    const duration = prefersReducedMotion ? 1 : 900;
    const start = performance.now();

    const tick = (now) => {
      const progressValue = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - progressValue, 3);
      element.textContent = `${Math.round(end * eased)}${suffix}`;
      if (progressValue < 1) requestAnimationFrame(tick);
    };

    requestAnimationFrame(tick);
  };

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add("is-visible");
        if (entry.target instanceof HTMLElement && entry.target.matches("[data-count]")) {
          animateCount(entry.target);
        }
      });
    },
    { threshold: 0.18 }
  );

  revealTargets.forEach((target) => {
    target.classList.add("reveal");
    revealObserver.observe(target);
  });

  countTargets.forEach((target) => revealObserver.observe(target));

  requestAnimationFrame(() => {
    revealTargets.forEach((target) => {
      const rect = target.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        target.classList.add("is-visible");
      }
    });
  });

  interactiveCards.forEach((card) => {
    if (!(card instanceof HTMLElement)) return;

    card.addEventListener("pointermove", (event) => {
      const rect = card.getBoundingClientRect();
      const x = event.clientX - rect.left;
      const y = event.clientY - rect.top;
      const rotateX = ((y / rect.height) - 0.5) * -4;
      const rotateY = ((x / rect.width) - 0.5) * 4;

      card.style.setProperty("--x", `${x}px`);
      card.style.setProperty("--y", `${y}px`);

      if (!prefersReducedMotion) {
        card.style.transform = `perspective(900px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) translateY(-4px)`;
      }
    });

    card.addEventListener("pointerleave", () => {
      card.style.transform = "";
    });
  });

  window.addEventListener("scroll", () => {
    updateProgress();
    setActiveNav();
  }, { passive: true });

  updateProgress();
  setActiveNav();
</script>
