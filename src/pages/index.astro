---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <main class="portfolio">
    <nav class="nav" aria-label="Primary navigation">
      <a class="brand" href="#home">MJ</a>
      <div class="nav-links">
        <a href="#work">Work</a>
        <a href="#systems">Systems</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>

    <section class="hero" id="home">
      <div class="hero-copy">
        <p class="eyebrow">Maninderjit Johar · Full-stack developer</p>
        <h1>I build product-ready web platforms for SaaS teams.</h1>
        <p class="hero-text">
          7+ years shipping React, Next.js, TypeScript, Python, GraphQL, Docker, and Kubernetes systems across product UI, APIs, partner integrations, and reliable release workflows.
        </p>
        <div class="hero-actions">
          <a class="button primary" href="#work">View experience</a>
          <a class="button ghost" href="mailto:maninderjit.johar@outlook.com">Email me</a>
        </div>
      </div>

      <aside class="hero-card" aria-label="Career highlights">
        <div class="availability">Open to full-stack and frontend roles</div>
        <div class="proof-grid">
          <span><strong>7+</strong> years experience</span>
          <span><strong>10+</strong> Next.js/React apps</span>
          <span><strong>15+</strong> backend services</span>
          <span><strong>100+</strong> reliability tests</span>
        </div>
      </aside>
    </section>

    <section class="impact-band" aria-label="Impact metrics">
      <article>
        <strong>30%</strong>
        <span>customer satisfaction lift</span>
      </article>
      <article>
        <strong>25%</strong>
        <span>fewer scheduling errors</span>
      </article>
      <article>
        <strong>23%</strong>
        <span>sales increase in two months</span>
      </article>
      <article>
        <strong>97%</strong>
        <span>object-detection accuracy supported</span>
      </article>
    </section>

    <section class="section" id="work">
      <div class="section-heading">
        <p class="eyebrow">Selected experience</p>
        <h2>Recent work, framed around business and engineering outcomes.</h2>
      </div>

      <div class="case-grid">
        <article class="case-card featured">
          <div class="case-meta">
            <span>June 2024 - Present</span>
            <span>Aerialytic</span>
          </div>
          <h3>Full-stack platform engineering for solar SaaS workflows.</h3>
          <p>
            Rejoined Aerialytic after an earlier frontend role and expanded into full-stack product engineering across lead capture, customer workflows, proposals, admin operations, and partner-facing experiences.
          </p>
          <div class="case-stats">
            <span><strong>100+</strong> project ecosystem</span>
            <span><strong>10+</strong> Next.js/React apps</span>
            <span><strong>15+</strong> backend services</span>
            <span><strong>100+</strong> Python/API tests</span>
          </div>
          <ul>
            <li>Modularized CRM capabilities into embeddable partner-ready experiences with secure sessions and configuration-driven flows.</li>
            <li>Implemented REST and GraphQL workflows for solar design, production modeling, savings calculations, lead management, and proposal generation.</li>
            <li>Containerized and deployed services with Docker, Kubernetes, GitHub Actions, and GitOps workflows.</li>
          </ul>
        </article>

        <article class="case-card">
          <div class="case-meta">
            <span>Nov 2021 - Jan 2024</span>
            <span>MarketBox</span>
          </div>
          <h3>Booking and scheduling product improvements.</h3>
          <p>
            Redesigned booking, console, and onboarding workflows for a fast-moving SaaS product.
          </p>
          <div class="case-stats compact">
            <span><strong>30%</strong> satisfaction lift</span>
            <span><strong>25%</strong> fewer scheduling errors</span>
            <span><strong>23%</strong> sales increase</span>
            <span><strong>6s -> 3.5s</strong> load-time improvement</span>
          </div>
        </article>

        <article class="case-card">
          <div class="case-meta">
            <span>Dec 2018 - Nov 2021</span>
            <span>Aerialytic</span>
          </div>
          <h3>Frontend foundations in solar data visualization.</h3>
          <p>
            Built scalable React experiences for solar-energy applications while collaborating with AI, GIS, and backend teams.
          </p>
          <div class="case-stats compact">
            <span><strong>20%</strong> faster rollout</span>
            <span><strong>97%</strong> accuracy supported</span>
          </div>
        </article>
      </div>
    </section>

    <section class="section systems" id="systems">
      <div class="section-heading">
        <p class="eyebrow">How I work</p>
        <h2>Product-minded engineering across the stack.</h2>
      </div>

      <div class="systems-grid">
        <article>
          <span>01</span>
          <h3>Interfaces that ship</h3>
          <p>React, Next.js, TypeScript, Apollo Client, responsive UI, state flows, and reusable component systems.</p>
        </article>
        <article>
          <span>02</span>
          <h3>APIs that scale</h3>
          <p>REST, GraphQL, Django, FastAPI, Python services, data modeling, and calculation-heavy product workflows.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Delivery that holds up</h3>
          <p>Docker, Kubernetes, GitHub Actions, GitOps, testing strategy, and multi-environment release practices.</p>
        </article>
      </div>
    </section>

    <section class="section" id="projects">
      <div class="section-heading project-heading">
        <p class="eyebrow">Public projects</p>
        <h2>Small projects with clear engineering signals.</h2>
      </div>

      <div class="project-grid">
        <a class="project-card" href="https://github.com/maninderjit-johar/cinequiz" target="_blank" rel="noreferrer">
          <span>React · TypeScript · Redux Toolkit</span>
          <h3>CineQuiz</h3>
          <p>Movie-guessing game with async data, player flow, Radix UI primitives, and responsive interaction design.</p>
        </a>
        <a class="project-card" href="https://github.com/maninderjit-johar/essentialui" target="_blank" rel="noreferrer">
          <span>React library · Vite · Theme context</span>
          <h3>EssentialUI</h3>
          <p>Reusable component library focused on a package-ready, responsive, themeable sidebar system.</p>
        </a>
        <a class="project-card" href="https://github.com/maninderjit-johar/aspirearc" target="_blank" rel="noreferrer">
          <span>Next.js · Prisma · PostgreSQL · Docker</span>
          <h3>AspireArc</h3>
          <p>Full-stack fitness logger with relational workout history and Docker-based local infrastructure.</p>
        </a>
      </div>
    </section>

    <section class="contact" id="contact">
      <p class="eyebrow">Let’s talk</p>
      <h2>Have a product challenge worth solving?</h2>
      <p>
        I’m open to full-stack and frontend opportunities where user experience, APIs, and dependable delivery matter.
      </p>
      <div class="hero-actions center">
        <a class="button primary" href="mailto:maninderjit.johar@outlook.com">Email me</a>
        <a class="button ghost" href="https://www.linkedin.com/in/manijohar/" target="_blank" rel="noreferrer">LinkedIn</a>
        <a class="button ghost" href="https://github.com/maninderjit-johar" target="_blank" rel="noreferrer">GitHub</a>
      </div>
    </section>
  </main>
</Layout>
